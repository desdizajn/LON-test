# LON Production Environment Variables
# ВАЖНО: Копирај го овој фајл како .env и пополни ги вистинските вредности

# SQL Server Configuration
SQL_SA_PASSWORD=your_strong_password_here

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here_at_least_64_characters

# OpenAI Configuration (опционално)
OPENAI_API_KEY=sk-your-openai-key-here
ENABLE_VECTOR_STORE=false

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
